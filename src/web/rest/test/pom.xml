<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.geofence</groupId>
    <artifactId>geofence-rest-root</artifactId>
    <version>3.9-SNAPSHOT</version>
  </parent>

  <groupId>org.geofence</groupId>
  <artifactId>geofence-rest-test</artifactId>
  <packaging>war</packaging>

  <name>GeoFence - Web - REST webapp test</name>

  <!-- A thin wrapper webapp: depends on geofence-web-app's own classes (its -classes.jar artifact, produced via
       maven-war-plugin's attachClasses) for the real DispatcherServlet/AuthenticationFilter wiring, and adds only
       a test-data seeder on top. Runs on its own port (9191) so it can't be confused with, or corrupt, a real
       GeoFence instance a developer might have running separately. -->

  <dependencies>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.geofence</groupId>
      <artifactId>geofence-web-app</artifactId>
      <type>jar</type>
      <classifier>classes</classifier>
    </dependency>

  </dependencies>

  <build>

    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
      </plugin>

      <!-- Run the application using "mvn jetty:run" -->
      <plugin>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-maven-plugin</artifactId>
        <version>11.0.26</version>
        <configuration>
          <webApp>
            <contextPath>/geofence</contextPath>
          </webApp>
          <httpConnector>
            <port>9191</port>
            <idleTimeout>60000</idleTimeout>
          </httpConnector>
        </configuration>
      </plugin>
    </plugins>

  </build>

</project>
