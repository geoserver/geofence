# Sample datasource configuration file for GeoFence's own database connection.
#
# Copy this file to "geofence-datasource.properties" and place it wherever
# GEOFENCE_DATASOURCE_FILE (system property or env var) points to - an absolute path if set to
# one, or the current working directory otherwise. When running embedded in GeoServer, it's also
# checked automatically under "geofence/" inside GeoServer's own data directory, no extra
# configuration needed.
#
# All four properties are required; there is no built-in default database.

geofence.datasource.driver=org.postgresql.Driver
geofence.datasource.url=jdbc:postgresql://localhost:5432/geofence
geofence.datasource.username=geofence
geofence.datasource.password=geofence
